#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_TOOLCHAIN_FILE=cmake/toolchain-x86_64-linux-gnu.cmake

override_dh_auto_install:
	mkdir -p debian/corerealtime/usr/bin
	mkdir -p debian/corerealtime/etc/corerealtime

	cp obj-*/corerealtime debian/corerealtime/usr/bin/

	cp config.example.yml debian/corerealtime/etc/corerealtime/config.yml

	chmod 755 debian/corerealtime/usr/bin/corerealtime
